{
    "extends": [
        "plugin:@wordpress/eslint-plugin/recommended"
    ],
    "plugins": [
        "jest"
    ],
    "env": {
        "jest/globals": true
    },
    "settings": {
        "import/resolver": {
            "typescript": {
                "alwaysTryTypes": true
            }
        }
    },
    "rules": {
        // Turn on errors for missing imports.
        "import/no-unresolved": "error",
        "import/named": "off",
        "no-console": [
            "off"
        ]
    },
    "overrides": [
        {
            "files": [
                "src/crawler/**/*.ts"
            ],
            "rules": {
                "react/no-is-mounted": "off"
            }
        }
    ]
}
